<?xml version="1.0"?>
<package format="3">
  <name>rov_state_bridge</name>
  <version>0.1.0</version>
  <description>Read-only SHM to ROS2 bridge and advisory health monitor for UnderwaterRobotSystem.</description>
  <maintainer email="wys@example.com">wys</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>rov_msgs</depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
